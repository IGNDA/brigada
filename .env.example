# ============================================================
# BOF-RJ — Variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com seus valores.
# `.env.local` NÃO deve ser commitado (já está no .gitignore).
# ============================================================

# URL pública do Cloudflare Worker (rota do backend da galeria).
# Exemplo: https://bof-rj-gallery.<seu-subdominio>.workers.dev
# Atenção: este valor fica exposto no bundle (é público). Use o domínio
# público do worker, nunca o ADMIN_SECRET aqui.
NEXT_PUBLIC_GALLERY_WORKER_URL=

# Base pública de leitura das imagens no R2 (domínio público do bucket).
# Exemplo: https://pub-<hash-do-bucket>.r2.dev
NEXT_PUBLIC_R2_PUBLIC_BASE=

# Google Analytics 4 — ID de medição (ex.: G-XXXXXXX).
# Deixe vazio para desativar o Analytics. (Como todo NEXT_PUBLIC_*, fica
# exposto no site — é público e esperado.)
NEXT_PUBLIC_GA_ID=

# ============================================================
# Configurações do Cloudflare Worker (worker/wrangler.toml)
# ============================================================
# Bucket R2 criado na conta Cloudflare (binding name "GALLERY_BUCKET").
#   wrangler.toml  ->  bucket_name = "bof-rj"
#
# Senha do admin (variável secreta do Worker). Configure com:
#   cd worker && npx wrangler secret put ADMIN_SECRET
# Essa senha é usada no login da área /admin.

TESTE=ignda@092026
